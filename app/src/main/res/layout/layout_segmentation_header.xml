<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <EditText
        android:id="@+id/et_text_segmentation_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_hollow_radius_12dp"
        android:backgroundTint="@color/theme_color"
        android:gravity="top|start"
        android:inputType="textMultiLine"
        android:maxLines="6"
        android:minHeight="120dp"
        android:padding="12dp"
        android:textColor="@color/black"
        android:textColorHint="@color/gray"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/btn_text_segmentation"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/background_rounded_ripple_solid"
        android:backgroundTint="@color/theme_color"
        android:gravity="center"
        android:text="@string/text_segmentation"
        android:textColor="@android:color/white"
        android:textSize="20sp" />

</LinearLayout>