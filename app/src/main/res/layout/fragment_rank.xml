<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="15dp"
    android:background="@color/white"
    tools:context=".ui.fragment.RankFragment">

    <com.flyco.tablayout.SlidingTabLayout
        android:id="@+id/slide"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginStart="@dimen/app_layout_margin"
        android:layout_marginEnd="@dimen/app_layout_margin"
        android:background="@android:color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tl_indicator_color="@color/theme_color"
        app:tl_indicator_margin_left="15dp"
        app:tl_indicator_margin_right="15dp"
        app:tl_tab_padding="15dp"
        app:tl_textSelectColor="@color/theme_color"
        app:tl_textUnselectColor="@color/black"
        app:tl_textsize="16sp" />

    <com.gitee.cnsukidayo.anylanguageword.ui.adapter.customview.SlidingScrollableHost
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/slide">

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/fragment_i_start_viewpage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.gitee.cnsukidayo.anylanguageword.ui.adapter.customview.SlidingScrollableHost>


    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="150dp"
        app:cardBackgroundColor="@color/learn_back_ground_99"
        app:cardCornerRadius="30dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/fragment_rank_complete"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/style_image_padding"
            android:foreground="@drawable/item_gray_select"
            android:gravity="center"
            android:scaleType="fitCenter"
            android:src="@drawable/flag_close" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/fragment_rank_complete_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="185dp"
        android:text="4411"
        android:textColor="@android:color/holo_red_dark"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
