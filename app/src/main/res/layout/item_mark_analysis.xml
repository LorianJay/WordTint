<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tv_word_origin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:autoSizeMinTextSize="12sp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        app:autoSizeTextType="uniform"
        tools:text="abandon" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/pb_analysis_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="3"
        android:max="100"
        android:progress="0"
        app:indicatorColor="@array/green_gradient"
        app:trackColor="#E8F5E9"
        app:trackThickness="24dp" />

    <!-- 次数 -->
    <TextView
        android:id="@+id/tv_mark_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minWidth="40dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="13sp"
        tools:text="12次" />

    <TextView
        android:id="@+id/tv_avg_stay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="50dp"
        android:textColor="@color/dark_gray"
        android:textSize="11sp"
        tools:text="平均:2.3s" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/right_diamond"
        android:textColor="@color/dark_gray"
        android:textSize="16sp" />

</LinearLayout>
