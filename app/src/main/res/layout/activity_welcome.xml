<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activity.WelcomeActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="30dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="50dp">

        <ImageView
            android:id="@+id/iv_welcome_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/txt_welcome_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@id/iv_welcome_icon"
            android:gravity="center_vertical"
            android:text="@string/fragment_welcome_welcome"
            android:textSize="20sp"
            tools:ignore="SmallSp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/txt_welcome_title"
            android:layout_alignBottom="@id/iv_welcome_icon"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@id/iv_welcome_icon"
            android:autoSizeTextType="uniform"
            android:gravity="center_vertical"
            android:text="@string/app_name"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_welcome_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/iv_welcome_icon"
            android:layout_marginTop="30dp"
            android:inputType="none"
            android:scrollbars="vertical"
            android:textColor="@color/black"
            android:textIsSelectable="true"
            android:textSize="18sp" />

        <LinearLayout
            android:id="@+id/ll_agreement"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal"
            android:visibility="visible">

            <TextView
                android:id="@+id/btn_welcome_disagree_agreement"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_rounded_ripple_hollow"
                android:backgroundTint="@color/theme_color"
                android:gravity="center"
                android:text="@string/disagree"
                android:textColor="@color/theme_color"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/btn_welcome_accept_agreement"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="30dp"
                android:layout_weight="1"
                android:background="@drawable/bg_rounded_ripple_solid"
                android:backgroundTint="@color/theme_color"
                android:gravity="center"
                android:text="@string/accept"
                android:textColor="@android:color/white"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_init_progress"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_alignParentBottom="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/initialization"
                android:textColor="@android:color/black"
                android:textSize="20sp" />

            <ProgressBar
                android:id="@+id/pb_init_progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="center"
                android:layout_marginTop="5dp"
                android:max="100"
                android:progress="0" />

        </LinearLayout>


    </RelativeLayout>

</LinearLayout>