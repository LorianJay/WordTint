<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_simple_star"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:foreground="@drawable/background_rounded_ripple_hollow"
    android:foregroundTint="@color/dark_gray"
    android:layout_marginTop="3dp"
    android:orientation="horizontal"
    android:paddingStart="3dp"
    android:paddingEnd="3dp">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="4dp"
        android:gravity="center"
        android:rotation="90"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_up"
        app:tint="@color/dark_gray" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_marginTop="3dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_simple_star_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/default_txt"
            android:textColor="@color/black"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tv_simple_star_describe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/default_txt"
            android:textColor="@color/gray_black"
            android:textSize="18sp" />

    </LinearLayout>

</LinearLayout>